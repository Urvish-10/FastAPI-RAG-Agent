# ── App ───────────────────────────────────────────────────────────────────────
DEBUG=false
SECRET_KEY=your-super-secret-key-change-this-in-production

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Sync URL (used by Alembic and Celery)
DATABASE_URL=postgresql://user:password@localhost:5432/db_name
# Async URL (used by FastAPI/SQLAlchemy)
DATABASE_URL_ASYNC=postgresql+asyncpg://user:pass@localhost:5432/db_name

# ── Redis (Celery broker + backend) ──────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Pinecone ──────────────────────────────────────────────────────────────────
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_INDEX_NAME=rag-agent
PINECONE_ENVIRONMENT=us-east-1

# ── Google Gemini ─────────────────────────────────────────────────────────────
GEMINI_API_KEY=YOUR_API_KEY
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=3072

# ── Pinecone Rerank ───────────────────────────────────────────────────────────
# Uses the same PINECONE_API_KEY above — no extra key needed
# Model: bge-reranker-v2-m3 (multilingual, built into Pinecone Inference API)
# Override model name here if Pinecone releases a newer reranker:
# PINECONE_RERANK_MODEL=bge-reranker-v2-m3

# ── RAG parameters (optional overrides) ──────────────────────────────────────
RETRIEVAL_TOP_K=20
RERANK_TOP_N=5
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# ── File storage ──────────────────────────────────────────────────────────────
UPLOAD_DIR=/tmp/rag_uploads
MAX_FILE_SIZE_MB=50
